
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>LiveStream with Ads, Chat & Polls</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f8f9fa; padding: 20px; }
        video { width: 100%; max-height: 450px; }
        input, button { padding: 10px; margin: 5px; font-size: 16px; }
        ul { list-style: none; padding: 0; }
        li { background: #fff; margin: 5px 0; padding: 10px; border-radius: 5px; box-shadow: 1px 1px 5px rgba(0,0,0,0.1); }
    </style>
    <script src="client.js"></script>
</head>
<body>
    <h1>LiveStream Dashboard</h1>
    <video id="liveVideo" controls autoplay></video>
    
    <!-- Live Chat -->
    <div id="chat">
        <input type="text" id="messageInput" placeholder="Type a message...">
        <button onclick="sendMessage()">Send</button>
        <ul id="chatMessages"></ul>
    </div>

    <!-- Polls -->
    <div id="polls">
        <p>Which product do you prefer?</p>
        <button onclick="votePoll('Product A')">Product A</button>
        <button onclick="votePoll('Product B')">Product B</button>
    </div>

    <!-- Ads -->
    <div id="ad-container">
        <p id="ad-title"></p>
        <video id="adVideo" controls></video>
    </div>
</body>
</html>
